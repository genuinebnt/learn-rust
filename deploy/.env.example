# Copy to deploy/.env on the server (never commit it; the repo is public). docs/DEPLOY.md has the setup steps.

# openssl rand -hex 24
POSTGRES_PASSWORD=

# From `cargo run -q -p anneal-cli -- passphrase` (or `docker exec -it anneal-app anneal passphrase`).
# Keep the single quotes: the hash contains $ signs.
ANNEAL_PASSPHRASE_HASH=''

# getent group docker | cut -d: -f3
DOCKER_GID=
# id -u deploy / id -g deploy
DEPLOY_UID=1000
DEPLOY_GID=1000
